# Copy to .env and fill with your Supabase project values.
# These EXPO_PUBLIC_* values are embedded in builds; use the anon/publishable key only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also accepted as an alias.
